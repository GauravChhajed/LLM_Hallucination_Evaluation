# ==============================================================================
# LLM Hallucination Detection and Evaluation - Environment Configuration
# Copy this file to ".env" and fill in optional API keys if using API models.
# Never commit your ".env" file to version control.
# ==============================================================================

# Hugging Face & Embedding Model Cache (stored on D: drive to preserve C: space)
HF_HOME=D:\hf_cache
HF_HUB_CACHE=D:\hf_cache\hub
SENTENCE_TRANSFORMERS_HOME=D:\hf_cache\sentence_transformers

# Compute Device ("auto", "cuda", or "cpu")
DEVICE=auto

# Default Models (must match keys in models/model_config.py or valid model IDs)
DEFAULT_MODEL_A=qwen2.5-1.5b
DEFAULT_MODEL_B=flan-t5-large
DEFAULT_JUDGE_MODEL=qwen2.5-1.5b
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Optional Free-Tier API Keys (only needed if selecting API-backed models)
HF_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
